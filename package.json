{
  "name": "instacart-ca-mcp",
  "version": "0.1.0",
  "description": "MCP server for Instacart Canada (instacart.ca) — search products and compare prices across stores via the internal GraphQL API, using your logged-in Chrome session.",
  "type": "module",
  "bin": {
    "instacart-ca-mcp": "dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch"
  },
  "keywords": ["mcp", "instacart", "grocery", "canada", "price-comparison"],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "chrome-remote-interface": "^0.33.2"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^20.0.0"
  }
}
